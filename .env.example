# Keep the real values in backend/.env locally and in Render's Environment page.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Resend sends through HTTPS, which works on Render's free plan.
# Create a sending-only key and use an address at a Resend-verified domain.
RESEND_API_KEY=re_your_sending_key
EMAIL_FROM=Student Resource Hub <noreply@your-verified-domain.com>

# Optional: recipient for GET /api/test-email
EMAIL_TEST_RECIPIENT=you@example.com
